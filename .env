# Configuration Globale
APP_VERSION=4.1.0
ENVIRONMENT=development

# Mode de Trading (SÉCURITÉ)
# Options: demo | live (Ne jamais mettre 'live' sans validation)
TRADING_MODE=demo
TRADING_ENABLED=false

# Pocket Option Credentials (utilisé uniquement en live / demo authentifiée)
PO_SSID=
PO_USER_ID=

# Twelve Data API
TWELVE_DATA_API_KEY=votre_cle_api_ici

# Paramètres de Marché
ASSET=EURUSD
TIMEFRAME=15m

# Gestion du Capital & Risque
DEFAULT_ACCOUNT_BALANCE=1000.0
DEFAULT_RISK_PERCENT=1.0
